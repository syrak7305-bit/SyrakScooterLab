<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0C0C12">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SYRAK SCOOTERLAB"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#00E6FF"
        android:paddingBottom="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tuning, Telemetrie &amp; Safety Guard"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:paddingBottom="12dp"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bereit. Starte den Scan nahe deines E-Scooters."
        android:textSize="14sp"
        android:textColor="#CCCCCC"
        android:paddingBottom="12dp"/>

    <Button
        android:id="@+id/scanButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BLE-SCAN STARTEN"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GEFUNDENE GERÄTE"
            android:textSize="14sp"
            android:textColor="#00E6FF"/>

        <Button
            android:id="@+id/filterButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FILTER: NUR SCOOTER"
            android:textSize="10sp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/deviceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <!-- DASHBOARD LAYOUT -->
    <LinearLayout
        android:id="@+id/dashboardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/connectedDeviceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛴 E-Scooter"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#00FFC8"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/safetyGuardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛡️ Safety Guard: Aktiv"
            android:textSize="13sp"
            android:textColor="#FFFF00"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/speedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Geschwindigkeit: 0.0 km/h"
            android:textSize="16sp"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/batteryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Akkustand: -- %"
            android:textSize="14sp"
            android:textColor="#FFFF00"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>

        <TextView
            android:id="@+id/firmwareInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Protokoll: Aktiv"
            android:textSize="13sp"
            android:textColor="#CCCCCC"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/telemetryLogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telemetrie bereit."
            android:textSize="11sp"
            android:textColor="#888888"
            android:paddingBottom="12dp"/>

        <Button
            android:id="@+id/germanManeuverBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ GERMAN MANEUVER (RAM TUNING)"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/forceOverrideBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ FORCE FLASH / OVERRIDE"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/panicButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚨 POLICE MODE / PANIK-BUTTON"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/disconnectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VERBINDUNG TRENNEN"/>
    </LinearLayout>

</LinearLayout>
