<?xml version="1.0" encoding="utf-8"?>
<!--
  Syrak ScooterLab — AndroidManifest.xml
  ---------------------------------------------------------------------------
  BUGFIX "Rotation/Background": Die MainActivity deklariert
  android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout".
  Dadurch wird die Activity bei einer Drehung NICHT neu erstellt. Das ist hier
  zwingend, weil die komplette UI programmatisch aufgebaut wird und eine aktive
  BLE-Verbindung (BluetoothGatt) + Write-Queue nicht verloren gehen darf.
  Alle anderen UI-Zustaende (Tabs, Trip-Computer, Log-Terminal) bleiben so erhalten.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================== BLE-BERECHTIGUNGEN ===================== -->

    <!-- Legacy (< Android 12 / API 31): klassische Bluetooth-Rechte. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Legacy (< Android 12): BLE-Scan benoetigt Standort. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Android 12+ (API 31): getrennte Scan-/Connect-Rechte. -->
    <!-- neverForLocation: wir leiten KEINEN Standort aus Scan-Ergebnissen ab. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- ===================== HARDWARE-FEATURES ===================== -->

    <!-- Die App ist ohne BLE-Hardware nicht nutzbar, laeuft aber weiter (Demo-Modus). -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:label="Syrak ScooterLab"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Syrak ScooterLab"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
